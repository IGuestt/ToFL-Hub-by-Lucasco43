-- AUTO SKIP + TELEPORT
local AutoSkipEnabled = false

PrivateTab:CreateToggle({
    Name = "Auto Skip + Teleport",
    CurrentValue = false,
    Flag = "AutoSkipTeleport",

    Callback = function(Value)
        AutoSkipEnabled = Value

        if not AutoSkipEnabled then
            return
        end

        task.spawn(function()
            while AutoSkipEnabled do
                local Success, ErrorMessage = pcall(function()
                    CommandRemote:FireServer("/skip")

                    task.wait(2)

                    if not AutoSkipEnabled then
                        return
                    end

                    local Finish = workspace
                        :WaitForChild("tower")
                        :WaitForChild("sections")
                        :WaitForChild("finish")

                    local Character = Player.Character
                        or Player.CharacterAdded:Wait()

                    local Root = Character:WaitForChild(
                        "HumanoidRootPart"
                    )

                    local Destination

                    if Finish:IsA("BasePart") then
                        Destination = Finish.CFrame
                    elseif Finish:IsA("Model") then
                        Destination = Finish:GetPivot()
                    end

                    if Destination then
                        Root.CFrame = Destination
                            + Vector3.new(0, 3, 0)
                    end
                end)

                if not Success then
                    warn(
                        "Auto Skip error: "
                        .. tostring(ErrorMessage)
                    )

                    AutoSkipEnabled = false
                    break
                end

                task.wait(1)
            end
        end)
    end,
})

